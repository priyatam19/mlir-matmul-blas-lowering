# Reproducible torch-mlir/MLIR development image with CUDA/NVPTX support.
# Build from the repository root:
#   docker build -f docker/Dockerfile.cuda -t mlir-tutorial:cuda .

FROM nvidia/cuda:12.8.1-devel-ubuntu22.04 AS build-base

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates ccache clang cmake git libopenblas-dev lld \
    ninja-build python3 python3-dev python3-pip python3-venv wget \
    && rm -rf /var/lib/apt/lists/*

ENV CC=clang
ENV CXX=clang++
ENV CUDA_HOME=/usr/local/cuda
ENV LIBRARY_PATH=/usr/local/cuda/lib64/stubs

FROM build-base AS torch-mlir-build

ARG TORCH_MLIR_COMMIT=c15565667004fe1f3726404afb3f3f862a945551
ARG LLVM_COMMIT=068c6c5c0c8a0555036a2ff09a99f486548e6e8d

WORKDIR /build

RUN git config --global url.https://github.com/.insteadOf git@github.com: && \
    git clone --filter=blob:none https://github.com/DavidGinten/torch-mlir.git externals/torch-mlir && \
    git -C externals/torch-mlir checkout "${TORCH_MLIR_COMMIT}" && \
    git -C externals/torch-mlir submodule update --init --recursive --depth 1 && \
    test "$(git -C externals/torch-mlir rev-parse HEAD)" = "${TORCH_MLIR_COMMIT}" && \
    test "$(git -C externals/torch-mlir/externals/llvm-project rev-parse HEAD)" = "${LLVM_COMMIT}"

RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

ARG TORCH_VERSION=2.13.0+cpu
ARG TORCHVISION_VERSION=0.28.0+cpu

WORKDIR /build/externals/torch-mlir
RUN pip install --upgrade pip && \
    pip install --index-url https://download.pytorch.org/whl/cpu \
      "torch==${TORCH_VERSION}" "torchvision==${TORCHVISION_VERSION}" && \
    pip install -r build-requirements.txt -r test-requirements.txt && \
    pip install pybind11

WORKDIR /build
RUN cmake -GNinja -Bbuild \
    -DCMAKE_BUILD_TYPE=Release \
    -DLLVM_ENABLE_ASSERTIONS=ON \
    -DPython3_FIND_VIRTUALENV=ONLY \
    -DPython_FIND_VIRTUALENV=ONLY \
    -DMLIR_ENABLE_BINDINGS_PYTHON=ON \
    -DLLVM_TARGETS_TO_BUILD="Native;NVPTX" \
    -DCMAKE_C_COMPILER=clang \
    -DCMAKE_CXX_COMPILER=clang++ \
    -DLLVM_USE_LINKER=lld \
    -DLLVM_CCACHE_BUILD=ON \
    -DLLVM_ENABLE_PROJECTS=mlir \
    -DMLIR_ENABLE_CUDA_RUNNER=ON \
    -DLLVM_EXTERNAL_PROJECTS=torch-mlir \
    -DLLVM_EXTERNAL_TORCH_MLIR_SOURCE_DIR=/build/externals/torch-mlir \
    -DTORCH_MLIR_ENABLE_PYTORCH_EXTENSIONS=ON \
    -DTORCH_MLIR_ENABLE_JIT_IR_IMPORTER=ON \
    externals/torch-mlir/externals/llvm-project/llvm

RUN ninja -C build -j"$(nproc)" \
    FileCheck MLIRPythonModules TorchMLIRPythonModules count llc \
    mlir-headers mlir-opt mlir-runner mlir-translate mlir_cuda_runtime \
    mlir_runner_utils not \
    torch-mlir-opt

RUN ninja -C build -j"$(nproc)" mlir_c_runner_utils

FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04@sha256:ad6d59a3bbf3e82c1c849c9ac09cfc2a3e0bbb8655042fd899be6681b3fe2a85 AS runtime-base

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates ccache clang cmake git libopenblas-dev lld \
    ninja-build python3 python3-dev python3-pip python3-venv wget \
    cuda-nsight-systems-12-8 \
    && rm -rf /var/lib/apt/lists/*

ENV CC=clang
ENV CXX=clang++
ENV CUDA_HOME=/usr/local/cuda
ENV LIBRARY_PATH=/usr/local/cuda/lib64/stubs

FROM runtime-base AS final

ARG TORCH_MLIR_COMMIT=c15565667004fe1f3726404afb3f3f862a945551
ARG LLVM_COMMIT=068c6c5c0c8a0555036a2ff09a99f486548e6e8d
ARG TORCH_VERSION=2.13.0+cpu
ARG TORCHVISION_VERSION=0.28.0+cpu
ARG PYTORCH_CUDA_VERSION=2.8.0+cu128

COPY --from=torch-mlir-build /build /build
COPY --from=torch-mlir-build /opt/venv /opt/venv

RUN /usr/bin/python3 -m venv /opt/pytorch-cuda && \
    /opt/pytorch-cuda/bin/pip install --upgrade pip && \
    /opt/pytorch-cuda/bin/pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cu128 \
      "torch==${PYTORCH_CUDA_VERSION}"

ARG PYTORCH_CUDA_NUMPY_VERSION=2.1.2
RUN /opt/pytorch-cuda/bin/pip install --no-cache-dir \
      "numpy==${PYTORCH_CUDA_NUMPY_VERSION}"

ENV PATH=/opt/venv/bin:/build/build/bin:$PATH
ENV PYTHONPATH=/build/build/tools/mlir/python_packages/mlir_core:/build/build/tools/torch-mlir/python_packages/torch_mlir
ENV LD_LIBRARY_PATH=/build/build/lib:/usr/local/cuda/lib64:/usr/local/cuda/lib64/stubs:/usr/lib/x86_64-linux-gnu/openblas-pthread
ENV TORCH_MLIR_COMMIT=${TORCH_MLIR_COMMIT}
ENV LLVM_COMMIT=${LLVM_COMMIT}
ENV TORCH_VERSION=${TORCH_VERSION}
ENV TORCHVISION_VERSION=${TORCHVISION_VERSION}
ENV PYTORCH_CUDA_VERSION=${PYTORCH_CUDA_VERSION}
ENV PYTORCH_CUDA_NUMPY_VERSION=${PYTORCH_CUDA_NUMPY_VERSION}
ENV PYTORCH_CUDA_PYTHON=/opt/pytorch-cuda/bin/python

WORKDIR /workspace/project

RUN mlir-opt --version && \
    torch-mlir-opt --version && \
    nsys --version && \
    test -e /build/build/lib/libmlir_cuda_runtime.so && \
    test -e /build/build/lib/libmlir_c_runner_utils.so && \
    test -e /build/build/lib/libmlir_runner_utils.so && \
    llc --version >/dev/null && \
    python3 -c "import torch; print(torch.__version__)" && \
    python3 -c "import torch_mlir" && \
    /opt/pytorch-cuda/bin/python -c \
      "import numpy, torch; print(torch.__version__, torch.version.cuda, numpy.__version__)"

CMD ["/bin/bash"]
